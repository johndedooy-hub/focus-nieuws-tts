name: Focus Regio News TTS to TXT FF1

on:
  workflow_dispatch:

jobs:
  generate-news-audio:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install --upgrade git+https://github.com/rany2/edge-tts.git pydub mutagen requests
          sudo apt-get update
          sudo apt-get install -y ffmpeg

      - name: Download transcript from website
        run: |
          wget --quiet "https://www.focusfantastique.nl/ff-regioagenda.txt" -O ff-regioagenda.txt

          if [ ! -f "ff-regioagenda.txt" ]; then
            echo "ERROR: Failed to download transcript from website"
            exit 1
          fi

          echo "Transcript downloaded successfully:"
          ls -lh ff-regioagenda.txt

      - name: Check newsbed
        run: |
          if [ ! -f "newsbed.mp3" ]; then
            echo "ERROR: newsbed.mp3 not found"
            exit 1
          fi

          echo "Newsbed found:"
          ls -lh newsbed.mp3

      - name: Convert transcript to natural news speech
        run: |
          python3 << 'EOF'
          import asyncio
          import edge_tts
          import os
          import re
          import requests
          from pydub import AudioSegment

          input_file = "ff-regioagenda.txt"
          newsbed_file = "newsbed.mp3"
          output_file = "Focus-Regio-News.mp3"

          voice = "nl-NL-FennaNeural"
          rate = "+2%"

          def get_proxies():
              proxies = []
              # Haal een lijst van publieke HTTPS/SOCKS proxies op om Azure IP-blokkades te omzeilen
              try:
                  res = requests.get("https://api.proxyscrape.com/v2/?request=displayproxies&protocol=http&timeout=5000&country=all&ssl=yes&anonymity=all", timeout=10)
                  if res.status_code == 200:
                      lines = [f"http://{p.strip()}" for p in res.text.splitlines() if p.strip()]
                      proxies.extend(lines[:20])
              except Exception as e:
                  print(f"Waarschuwing bij ophalen proxylijst: {e}")
              return proxies

          print("Reading transcript...")

          with open(input_file, "r", encoding="utf-8") as f:
              text = f.read().strip()

          if not text:
              print("ERROR: Transcript is empty")
              exit(1)

          paragraphs = re.split(r'\n\s*\n', text)

          chunks = []
          current_chunk = ""
          max_chars = 3000

          for paragraph in paragraphs:
              paragraph = paragraph.strip()
              if not paragraph:
                  continue

              if len(current_chunk) + len(paragraph) + 2 <= max_chars:
                  if current_chunk:
                      current_chunk += "\n\n"
                  current_chunk += paragraph
              else:
                  if current_chunk:
                      chunks.append(current_chunk)

                  if len(paragraph) > max_chars:
                      sentences = re.split(r'(?<=[.!?])\s+', paragraph)
                      current_chunk = ""

                      for sentence in sentences:
                          if not sentence.strip():
                              continue

                          if len(current_chunk) + len(sentence) + 1 <= max_chars:
                              if current_chunk:
                                  current_chunk += " "
                              current_chunk += sentence
                          else:
                              if current_chunk:
                                  chunks.append(current_chunk)
                              current_chunk = sentence
                  else:
                      current_chunk = paragraph

          if current_chunk:
              chunks.append(current_chunk)

          proxy_pool = get_proxies()

          async def generate_chunk_with_retry(text, filename):
              # Probeer eerst direct; probeer bij 403 / connectiefout roterende proxies
              attempts = [None] + proxy_pool
              for p in attempts:
                  try:
                      if p:
                          print(f"Poging via proxy: {p}")
                          communicate = edge_tts.Communicate(text, voice, rate=rate, proxy=p)
                      else:
                          communicate = edge_tts.Communicate(text, voice, rate=rate)
                      await communicate.save(filename)
                      return
                  except Exception as err:
                      print(f"Fout ({p if p else 'direct'}): {err}")
                      await asyncio.sleep(1)
              raise RuntimeError(f"Genereren van {filename} is mislukt via alle beschikbare verbindingen.")

          async def main():
              audio_parts = []

              for index, chunk in enumerate(chunks, start=1):
                  filename = f"tts_part_{index}.mp3"
                  print(f"Generating part {index}/{len(chunks)}...")
                  await generate_chunk_with_retry(chunk, filename)
                  audio_parts.append(filename)

              final_audio = AudioSegment.empty()
              pause = AudioSegment.silent(duration=350)

              for index, filename in enumerate(audio_parts):
                  part = AudioSegment.from_mp3(filename)
                  if len(final_audio) > 0:
                      final_audio += pause
                  final_audio += part

              if os.path.exists(newsbed_file):
                  newsbed = AudioSegment.from_mp3(newsbed_file)
                  while len(newsbed) < len(final_audio):
                      newsbed += newsbed
                  newsbed = newsbed[:len(final_audio)]
                  newsbed = newsbed - 15
                  final_audio = final_audio.overlay(newsbed)

              final_audio.export(output_file, format="mp3", bitrate="96k")

              for filename in audio_parts:
                  if os.path.exists(filename):
                      os.remove(filename)

          asyncio.run(main())

          print("✓ TTS generation complete!")
          print(f"✓ Output: {output_file}")
          EOF

      - name: Add ID3 tags to final MP3
        run: |
          python3 << 'EOF'
          from mutagen.id3 import ID3, TIT2, TALB, TPE1, APIC, ID3NoHeaderError

          mp3 = "Focus-Regio-News.mp3"
          cover = "FocusRegioAgenda.jpg"

          try:
              tags = ID3(mp3)
          except ID3NoHeaderError:
              tags = ID3()

          tags.add(TPE1(encoding=3, text="Focus-Regio-Agenda"))   # Artiest
          tags.add(TALB(encoding=3, text="Focus-Regio-Agenda"))   # Album
          tags.add(TIT2(encoding=3, text="Focus-Regio-Agenda"))   # Titel

          with open(cover, "rb") as img:
              tags.add(APIC(
                  encoding=3,
                  mime="image/jpeg",
                  type=3,
                  desc="Cover",
                  data=img.read()
              ))

          tags.save(mp3)
          print("✓ ID3 tags added successfully")
          EOF

      - name: Show output
        run: |
          echo "Generated audio:"
          ls -lh Focus-Regio-News.mp3

      - name: Configure Git
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

      - name: Commit and push changes
        run: |
          if git diff --quiet Focus-Regio-News.mp3; then
            echo "No changes to Focus-Regio-News.mp3"
          else
            git add Focus-Regio-News.mp3
            git commit -m "Update: Focus Regio News"
            git push
          fi
